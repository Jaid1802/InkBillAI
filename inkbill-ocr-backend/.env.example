# Server-side secrets for inkbill-ocr-backend.
# Never commit real values. Set these as secrets on Render / your local env.

# Required - Gemini API key (server-side only, never shipped to the Flutter client).
GEMINI_API_KEY=

# Optional - model to use for post-processing.
GEMINI_MODEL=gemini-1.5-flash

# Optional - only needed if the backend should write structured bills to Supabase.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional - set to "true" to enable best-effort writes to the "bills" table.
ENABLE_SUPABASE_PERSIST=false