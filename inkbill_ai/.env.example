# InkBill AI Configuration
# Copy this file to .env and fill in your values.

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# Backend OCR Configuration
OCR_BASE_URL=https://inkbill-ocr-backend.onrender.com
OCR_API_KEY=your-ocr-api-key-here

# Flutter build with --dart-define:
# flutter run --dart-define=SUPABASE_URL=... --dart-define=SUPABASE_ANON_KEY=... --dart-define=OCR_BASE_URL=... --dart-define=OCR_API_KEY=...
